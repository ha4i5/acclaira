# ===================================================
#  Acclaira — Environment Configuration
# ===================================================

# Application Security (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_hex_32
CRED_SECRET=your_credential_encryption_secret_hex_32

# Admin & Host URL
ADMIN_EMAIL=mail@acclaira.com
APP_URL=https://acclaira.com

# Self-Hosted SMTP Mail Server Configuration
SMTP_HOST=mail.acclaira.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@acclaira.com
SMTP_PASS=your_noreply_email_password
SMTP_FROM="Acclaira" <noreply@acclaira.com>

# Optional / External AI APIs (Can also be configured via Web UI Settings)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
