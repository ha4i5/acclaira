<!DOCTYPE html>

<html lang="en"><head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Mail - Acclaira{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('base.css') }}?2" />
    <link rel="stylesheet" href="{{ asset('resources/font-awesome-4.3.0/css/font-awesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('resources/chosen.bootstrap.css') }}">
    <link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
    <style>
        table tr[data-href] {
            cursor: pointer;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

{% block superbody %}
<nav class="navbar navbar-expand-md topnav color-top-border" role="navigation">
    <div class="container-fluid">
        <div class="navbar-header">

            <button type="button" class="btn-sm btn-default navbar-toggle collapsed" data-toggle="collapse" data-target="#subnavbar" aria-expanded="false" aria-controls="navbar">
                <span class="sr-only">{{ 'menu.toggle'|trans }}</span>
                <i class="fa fa-bars"></i>
            </button>

            <a class="navbar-brand" href="{{ path('dashboard') }}" style="display: flex; align-items: center; gap: 8px;">
                <span style="font-weight: 700; color: #fff; letter-spacing: -0.01em;">Acclaira</span>
                <span class="mailserver hidden-xs" style="color: #93c5fd; font-weight: 500;">Mail</span>
            </a>
        </div>


        <div id="subnavbar" class="navbar-collapse collapse" aria-expanded="false" style="height: 1px;">

            <div class="hidden-lg hidden-md hidden-sm">
                {% include "_menu.html.twig" %}
            </div>

            <ul class="nav navbar-nav navbar-right">
                <li><a href="/webmail" style="color: #e2e8f0;"><i class="fa fa-envelope"></i> {{ 'menu.webmail'|trans }}</a></li>
                <li><a href="{{ path('logout') }}" id="logout"><i class="fa fa-power-off"></i> {{ 'menu.logout'|trans }}</a></li>
            </ul>

        </div>

    </div>
</nav>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-3 col-md-2 sidebar">
            {% include "_menu.html.twig" %}

            <div style="padding: 20px 15px; font-size: 11px; color: #94a3b8; text-align: center; border-top: 1px solid #334155; margin-top: 20px;">
                &copy; Copyright PR MEDIA LLC.<br>All rights reserved.
            </div>
        </div>

        <div class="col-sm-9 col-md-10 main">
            <h1>{{ block('title') }}</h1>
            {% block body %}{% endblock %}
        </div>
    </div>
</div>

{% endblock %}

</body>

<script src="{{ asset('resources/jquery-2.1.3.min.js') }}"></script>
<script src="{{ asset('resources/bootstrap-3.3.1/dist/js/bootstrap.min.js') }}"></script>
<script src="{{ asset('resources/punycode.min.js') }}"></script>
<script src="{{ asset('resources/chosen.jquery.min.js') }}"></script>
<script>

function loadInfo() {
    $('span[data-reverse]').each(function () {
        $(this).load('/admin/tools/reverse?ip=' + $(this).attr('data-reverse'));
        $(this).removeAttr('data-reverse');
    })

    $('span[data-load]').each(function () {
        $(this).load($(this).attr('data-load'));
        $(this).removeAttr('data-load');
    });
}

function enrichPage() {
    // clickable rows
    $(document).on('click', 'table tr[data-href] a', function(e) {
        e.stopPropagation();
        window.location = $(this).attr('href');
        return false;
    });

    $(document).on('click', 'table tr[data-href]', function(e) {
        e.stopPropagation();
        window.location = $(this).data('href');
        return false;
    });

    // automatic reverses
    $(document).on('load change ajax/loaded', function() {
       loadInfo();
    });

    loadInfo();
}

$(document).ready(function(){
    console.log("enriching!");
    enrichPage();
});
</script>
{% block javascripts %}{% endblock %}

</html>
